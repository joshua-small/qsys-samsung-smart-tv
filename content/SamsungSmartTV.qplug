-- Samsung Smart TV - Joshua Small - 10/2026
-- External Tizen v2 WebSocket control, separate from the in-TV webapis SDK.
PluginInfo = {
  Name = "Samsung~Smart TV",
  Version = "1.0.0.3",
  BuildVersion = "1.0.0.3",
  Id = "93bb7a51-4382-49b8-9133-0aaaf05d1a46",
  Author = "Joshua Small",
  Manufacturer = "Samsung",
  Model = "Tizen Smart TV / Frame",
  Description = "Local WebSocket remote and Frame Art Mode. Requires TV approval; model-dependent.",
}

--*** Design-time constants ***
White = { 255, 255, 255 }
Black = { 0, 0, 0 }
PanelGray = { 230, 230, 230 }
ReadoutGray = { 194, 194, 194 }
SamsungBlue = { 20, 40, 160 }
IndicatorGreen = { 0, 160, 0 }
PageHeights = { 600, 585, 595, 445 }
LogoSvg =
  ""

--*** Remote key protocol names ***
RemoteKeys = {
  PowerOff = "KEY_POWEROFF",
  PowerToggle = "KEY_POWER",
  VolumeUp = "KEY_VOLUP",
  VolumeDown = "KEY_VOLDOWN",
  MuteToggle = "KEY_MUTE",
  Source = "KEY_SOURCE",
  Tv = "KEY_TV",
  Hdmi = "KEY_HDMI",
  Home = "KEY_HOME",
  Up = "KEY_UP",
  Menu = "KEY_MENU",
  Left = "KEY_LEFT",
  Enter = "KEY_ENTER",
  Right = "KEY_RIGHT",
  Return = "KEY_RETURN",
  Down = "KEY_DOWN",
  Exit = "KEY_EXIT",
  Digit1 = "KEY_1",
  Digit2 = "KEY_2",
  Digit3 = "KEY_3",
  Digit4 = "KEY_4",
  Digit5 = "KEY_5",
  Digit6 = "KEY_6",
  Digit7 = "KEY_7",
  Digit8 = "KEY_8",
  Digit9 = "KEY_9",
  Digit0 = "KEY_0",
  ChannelUp = "KEY_CHUP",
  ChannelDown = "KEY_CHDOWN",
  Guide = "KEY_GUIDE",
  Rewind = "KEY_REWIND",
  Play = "KEY_PLAY",
  Pause = "KEY_PAUSE",
  Stop = "KEY_STOP",
  Forward = "KEY_FF",
  Red = "KEY_RED",
  Green = "KEY_GREEN",
  Yellow = "KEY_YELLOW",
  Blue = "KEY_BLUE",
}

--*** Reserved design-time functions ***
function GetColor(props)
  return SamsungBlue
end

function GetPrettyName(props)
  return "Samsung Smart TV " .. PluginInfo.Version
end

function GetProperties()
  return {
    {
      Name = "Transport",
      Type = "enum",
      Choices = { "TLS (8002)", "Plain (8001)" },
      Value = "TLS (8002)",
    },
    { Name = "Frame Art Mode", Type = "boolean", Value = true },
    { Name = "Command Interval", Type = "double", Min = 0.1, Max = 2, Value = 0.3 },
    {
      Name = "App Launch Type",
      Type = "enum",
      Choices = { "DEEP_LINK", "NATIVE_LAUNCH" },
      Value = "DEEP_LINK",
    },
    {
      Name = "Debug Print",
      Type = "enum",
      Choices = { "None", "Tx", "Rx", "Tx/Rx", "Function Calls", "All" },
      Value = "None",
    },
  }
end

function RectifyProperties(props)
  props["Debug Print"].IsHidden = not props.plugin_show_debug.Value
  return props
end

function GetPages(props)
  return { { name = "Setup" }, { name = "Controls" }, { name = "Remote" }, { name = "Frame" } }
end

function GetComponents(props)
  return {
    {
      Name = "PairingStorage",
      Type = "custom_controls",
      Properties = { type_1 = 13, count_1 = 2 },
    },
  }
end

