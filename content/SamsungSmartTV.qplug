    Size = { 1, 1 },
    ZOrder = 4,
  }
  layout["ArtStatus"] = {
    PrettyName = "Frame~Art channel status",
    Style = "None",
    Position = { 0, 0 },
    Size = { 1, 1 },
    ZOrder = 4,
  }
  if props.page_index.Value == 1 then
    LayoutSetup(layout, graphics)
  elseif props.page_index.Value == 2 then
    LayoutControls(layout, graphics)
  elseif props.page_index.Value == 3 then
    LayoutRemote(layout, graphics)
  else
    LayoutFrame(layout, graphics)
  end
  return layout, graphics
end

