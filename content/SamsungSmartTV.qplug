--*** Runtime ***
if Controls then
  Json = require("rapidjson")

  --*** Control aliases and persistent state ***
  StoredToken = PairingStorage["text.1"]
  StoredIdentity = PairingStorage["text.2"]
  WantConnect = false
  Host = ""
  Client = ""
  Protocol = "wss"
  Port = 8002
  Queue = {}
  QueueWaiting = false
  ArtRequestId = nil
  ArtSequence = 0
  ArtSessionId = ""
  DebugTx = false
  DebugRx = false
  DebugFunction = false

  --*** Long-lived host objects ***
  Channels = {
    Remote = {
      Name = "Remote",
      Endpoint = "samsung.remote.control",
      Status = Controls.Status,
      Timeout = Timer.New(),
      Retry = Timer.New(),
      Ping = Timer.New(),
      Ready = false,
      Authorized = false,
      Blocked = false,
      RetryDelay = 5,
    },
    Art = {
      Name = "Art",
      Endpoint = "com.samsung.art-app",
      Status = Controls.ArtStatus,
      Timeout = Timer.New(),
      Retry = Timer.New(),
      Ping = Timer.New(),
      Ready = false,
      Authorized = false,
      Blocked = false,
      RetryDelay = 5,
    },
  }
  WakeSocket = UdpSocket.New()
  QueueTimer = Timer.New()
  ArtPollTimer = Timer.New()
  ArtReplyTimer = Timer.New()
  ArtQueryTimer = Timer.New()
  ArtFreshTimer = Timer.New()

  --*** Protocol limits and recognized events ***
  MaxMessageBytes = 65536
  MaxQueue = 16
  KnownEvents = {
    ["ms.channel.connect"] = true,
    ["ms.channel.ready"] = true,
    ["ms.channel.unauthorized"] = true,
    ["ms.channel.timeOut"] = true,
    ["ms.error"] = true,
    ["d2d_service_message"] = true,
  }

  --*** Utility and state functions ***
  function Trim(value)
    return (value:gsub("^%s+", ""):gsub("%s+$", ""))
  end

  function Trace(name)
    if DebugFunction then
      print("Function: " .. name)
    end
  end

  function SetupDebug()
    local mode = Properties["Debug Print"].Value
    DebugTx = mode == "Tx" or mode == "Tx/Rx" or mode == "All"
    DebugRx = mode == "Rx" or mode == "Tx/Rx" or mode == "All"
    DebugFunction = mode == "Function Calls" or mode == "All"
  end

  function SetStatus(channel, value, message)
    channel.Status.Value = value
    channel.Status.String = message
  end

  function Notice(message)
    Controls.LastEvent.String = message
    print(message)
  end

  function ClearArtState()
    ArtFreshTimer:Stop()
    Controls.ArtValid.Boolean = false
    Controls.ArtState.String = ""
  end

  function UpdateEnabled()
    Controls.Connected.Boolean = Channels.Remote.Ready
    for name in pairs(RemoteKeys) do
      Controls[name].IsDisabled = not Channels.Remote.Ready
    end
    Controls.SendKey.IsDisabled = not Channels.Remote.Ready
    Controls.LaunchApp.IsDisabled = not Channels.Remote.Ready
    for _, name in ipairs({ "ArtOn", "ArtOff", "ArtRefresh" }) do
      Controls[name].IsDisabled = not Channels.Art.Ready
    end
    Controls.TokenSaved.Boolean = StoredToken.String ~= ""
  end

  function ClearQueue()
    QueueTimer:Stop()
    Queue = {}
    QueueWaiting = false
  end

  function StopChannel(channel)
    channel.Timeout:Stop()
    channel.Retry:Stop()
    channel.Ping:Stop()
    channel.Ready = false
    channel.Authorized = false
    channel.Open = false
    channel.AwaitingPong = false
    local socket = channel.Socket
    channel.Socket = nil
    if socket then
      -- Invalidate identity before Close: synchronous or late callbacks are stale.
      pcall(function()
        socket:Close()
      end)
    end
    if channel == Channels.Remote then
      ClearQueue()
    else
      ArtPollTimer:Stop()
      ArtReplyTimer:Stop()
      ArtQueryTimer:Stop()
      ArtRequestId = nil
      ClearArtState()
    end
    UpdateEnabled()
  end

  function FailChannel(channel, message, block)
    Trace("FailChannel " .. channel.Name)
    local mayRetry = channel == Channels.Art or StoredToken.String ~= "" or channel.Authorized
    StopChannel(channel)
    channel.Blocked = block == true
    SetStatus(channel, 2, message)
    Notice(channel.Name .. ": " .. message)
    if channel == Channels.Remote then
      StopChannel(Channels.Art)
      SetStatus(
        Channels.Art,
        Properties["Frame Art Mode"].Value and 2 or 3,
        Properties["Frame Art Mode"].Value and "Remote connection unavailable"
          or "Art Mode disabled"
      )
    end
    if WantConnect and not channel.Blocked and mayRetry then
      channel.Retry:Start(channel.RetryDelay)
      channel.RetryDelay = math.min(channel.RetryDelay * 2, 60)
    end
  end

  function Decode(data)
    if type(data) ~= "string" or #data > MaxMessageBytes then
      return nil
    end
    local ok, result = pcall(Json.decode, data)
    if ok and type(result) == "table" then
      return result
    end
    return nil
  end

  function UrlEncode(value)
    return (
      value:gsub("([^%w%-._~])", function(char)
        return string.format("%%%02X", string.byte(char))
      end)
    )
  end

  function SaveToken(message)
    local data = message.data
    if Protocol == "wss" and type(data) == "table" then
      local token = data.token
      if type(token) == "number" then
        token = tostring(token)
      end
      if type(token) == "string" and #token > 0 and #token <= 512 and not token:find("%c") then
        StoredToken.String = token
      end
    end
    UpdateEnabled()
  end

  function WriteMessage(channel, message, label)
    if not channel.Ready or not channel.Socket then
      Notice(channel.Name .. ": command not sent; channel is not ready")
      return false
    end
    local encoded, payload = pcall(Json.encode, message)
    if not encoded or type(payload) ~= "string" or #payload > MaxMessageBytes then
      Notice(channel.Name .. ": command encoding failed")
      return false
    end
    local ok = pcall(function()
      channel.Socket:Write(payload, false)
    end)
    if not ok then
      FailChannel(channel, "Write failed; unsent commands discarded", false)
      return false
    end
    Controls.LastCommand.String = label
    if DebugTx then
      -- This payload contains commands only; connection URLs/tokens are never logged.
      print("Tx " .. channel.Name .. ": " .. payload)
    end
    return true
  end

  --*** Remote command pacing: no offline queue and no replay ***
  function DrainQueue()
    QueueTimer:Stop()
    QueueWaiting = false
    if not Channels.Remote.Ready then
      ClearQueue()
      return
    end
    local command = table.remove(Queue, 1)
    if command and WriteMessage(Channels.Remote, command.Message, command.Label) then
      QueueWaiting = true
      QueueTimer:Start(Properties["Command Interval"].Value)
    end
  end

  function Enqueue(message, label)
    if not Channels.Remote.Ready then
      Notice("Remote: command not sent; connect and approve on TV first")
      return
    end
    if #Queue >= MaxQueue then
      Notice("Remote: command not sent; queue is full")
      return
    end
    table.insert(Queue, { Message = message, Label = label })
    if not QueueWaiting then
      DrainQueue()
    end
  end

  function SendKey(key)
    Trace("SendKey")
    if type(key) ~= "string" or #key > 64 or not key:match("^KEY_[A-Z0-9_]+$") then
      Notice("Remote: enter a KEY_NAME using capital letters, digits and underscores")
      return
    end
    Enqueue({
      method = "ms.remote.control",
      params = {
        Cmd = "Click",
        DataOfCmd = key,
        Option = "false",
        TypeOfRemote = "SendRemoteKey",
      },
    }, key)
  end

  function LaunchApp()
    Trace("LaunchApp")
    local appId = Trim(Controls.AppId.String)
    if #appId < 1 or #appId > 128 or not appId:match("^[%w._%-]+$") then
      Notice("Remote: enter a valid application ID")
      return
    end
    Enqueue({
      method = "ms.channel.emit",
      params = {
        event = "ed.apps.launch",
        to = "host",
        data = { appId = appId, action_type = Properties["App Launch Type"].Value, metaTag = "" },
      },
    }, "Launch " .. appId)
  end

  --*** Frame Art Mode: correlate readback and expire stale feedback ***
  function ArtRequest(request, value)
    ArtSequence = ArtSequence + 1
    local id = ArtSessionId .. string.format("-%012x", ArtSequence)
    local data = { request = request, id = id, request_id = id }
    if value then
      data.value = value
    end
    local message = {
      method = "ms.channel.emit",
      params = { event = "art_app_request", to = "host", data = Json.encode(data) },
    }
    if WriteMessage(Channels.Art, message, request .. (value and (" " .. value) or "")) then
      return id
    end
    return nil
  end

  function QueryArt()
    Trace("QueryArt")
    ArtQueryTimer:Stop()
    if not Channels.Art.Ready or ArtRequestId then
      return
    end
    ArtRequestId = ArtRequest("get_artmode_status")
    if ArtRequestId then
      ArtReplyTimer:Start(8)
    end
  end

  function SetArt(value)
    Trace("SetArt")
    if not Channels.Art.Ready then
      Notice("Art: command not sent; Art channel is not ready")
      return
    end
    ArtReplyTimer:Stop()
    ArtRequestId = nil
    ClearArtState()
    if ArtRequest("set_artmode_status", value) then
      SetStatus(Channels.Art, 3, "Art command sent; awaiting readback")
      ArtQueryTimer:Start(1)
    end
  end

  function ReceiveArt(message)
    local data = Decode(message.data)
    if not data then
      Notice("Art: ignored invalid nested JSON")
      return
    end
    local id = data.request_id or data.id
    if ArtRequestId and id == ArtRequestId then
      if data.event == "error" then
        ArtReplyTimer:Stop()
        ArtRequestId = nil
        ClearArtState()
        SetStatus(Channels.Art, 1, "TV rejected Art status request")
        Notice("Art: TV rejected status request")
      elseif data.value == "on" or data.value == "off" then
        -- Only a matching read request can establish state; a sent command cannot.
        ArtReplyTimer:Stop()
        ArtRequestId = nil
        Controls.ArtState.String = data.value == "on" and "On" or "Off"
        Controls.ArtValid.Boolean = true
        ArtFreshTimer:Start(45)
        SetStatus(Channels.Art, 0, "Art Mode reported " .. data.value)
      end
    elseif data.event == "artmode_changed" or data.event == "art_mode_changed" then
      -- Notifications invalidate readback; query instead of inferring field names.
      ClearArtState()
      ArtReplyTimer:Stop()
      ArtRequestId = nil
      ArtQueryTimer:Start(0.3)
    elseif data.event == "error" then
      ClearArtState()
      SetStatus(Channels.Art, 1, "TV reported an Art request error")
      Notice("Art: request rejected by TV")
    end
  end

  function ArtReady()
    Channels.Art.Ready = true
    Channels.Art.Timeout:Stop()
    Channels.Art.RetryDelay = 5
    ArtSessionId = string.format(
      "%08x-%04x-4000-a000",
      math.floor(Timer.Now()) % 0x100000000,
      math.random(0, 65535)
    )
    SetStatus(Channels.Art, 5, "Art channel ready; reading state")
    UpdateEnabled()
    ArtPollTimer:Start(30)
    QueryArt()
  end

  --*** WebSocket lifecycle ***
  function Receive(channel, data)
    local message = Decode(data)
    if not message or type(message.event) ~= "string" then
      Notice(channel.Name .. ": ignored invalid or oversized event")
      return
    end
    local event = message.event
    if DebugRx then
      -- Never print raw responses: connect events contain the pairing token.
      print("Rx " .. channel.Name .. ": " .. (KnownEvents[event] and event or "other event"))
    end
    if event == "ms.channel.unauthorized" or event == "ms.channel.timeOut" then
      FailChannel(channel, "TV approval denied/timed out; press Connect to retry", true)
    elseif event == "ms.error" then
      if not channel.Ready then
        FailChannel(channel, "TV rejected channel; check API support", true)
      else
        SetStatus(channel, 1, "TV reported a command error")
        Notice(channel.Name .. ": TV reported a command error")
        if channel == Channels.Art then
          ClearArtState()
        end
      end
    elseif event == "ms.channel.connect" then
      if channel.Authorized then
        return
      end
      SaveToken(message)
      channel.Authorized = true
      channel.RetryDelay = 5
      if channel == Channels.Remote then
        channel.Ready = true
        channel.Timeout:Stop()
        SetStatus(channel, 0, "Remote authorized; device state not reported")
        Notice("Remote: authorized")
        UpdateEnabled()
        if Properties["Frame Art Mode"].Value then
          OpenChannel(Channels.Art)
        end
      elseif channel.ServiceReady then
        ArtReady()
      end
    elseif event == "ms.channel.ready" and channel == Channels.Art then
      channel.ServiceReady = true
      if channel.Authorized and not channel.Ready then
        ArtReady()
      end
    elseif event == "d2d_service_message" and channel == Channels.Art and channel.Ready then
      ReceiveArt(message)
    end
  end

  function OpenChannel(channel)
    Trace("OpenChannel " .. channel.Name)
    if not WantConnect or channel.Blocked or Host == "" then
      return
    end
    if
      channel == Channels.Art
      and (not Channels.Remote.Ready or not Properties["Frame Art Mode"].Value)
    then
      return
    end
    StopChannel(channel)
    channel.ServiceReady = false
    channel.Socket = WebSocket.New()
    channel.Socket.Connected = function(socket)
      if socket ~= channel.Socket then
        return
      end
      channel.Open = true
      SetStatus(channel, 5, "Connected; waiting for TV authorization")
      Notice(channel.Name .. ": socket connected; awaiting authorization")
      channel.Ping:Start(10)
    end
    channel.Socket.Data = function(socket, data)
      if socket == channel.Socket then
        Receive(channel, data)
      end
    end
    channel.Socket.Pong = function(socket)
      if socket == channel.Socket then
        channel.AwaitingPong = false
      end
    end
    channel.Socket.Error = function(socket)
      if socket == channel.Socket then
        -- Q-SYS error text may contain the URL/token; do not expose it.
        FailChannel(channel, "WebSocket error; check TV address and selected transport", false)
      end
    end
    channel.Socket.Closed = function(socket)
      if socket == channel.Socket then
        FailChannel(channel, "Connection closed; device power is unknown", false)
      end
    end
    local path = "/api/v2/channels/"
      .. channel.Endpoint
      .. "?name="
      .. UrlEncode(Crypto.Base64Encode(Client))
    if Protocol == "wss" and StoredToken.String ~= "" then
      path = path .. "&token=" .. UrlEncode(StoredToken.String)
    end
    SetStatus(channel, 5, "Connecting; approve on TV if prompted")
    Notice(channel.Name .. ": connecting")
    channel.Timeout:Start(45)
    local ok = pcall(function()
      channel.Socket:Connect(Protocol, Host, path, Port)
    end)
    if not ok then
      FailChannel(channel, "Unable to start WebSocket connection", false)
    end
  end

  function Disconnect()
    Trace("Disconnect")
    WantConnect = false
    StopChannel(Channels.Remote)
    StopChannel(Channels.Art)
    SetStatus(Channels.Remote, 3, "Disconnected")
    SetStatus(
      Channels.Art,
      3,
      Properties["Frame Art Mode"].Value and "Disconnected" or "Art Mode disabled"
    )
  end

  function Configure()
    Trace("Configure")
    Host = Trim(Controls.IPAddress.String):lower()
    Client = Trim(Controls.ClientName.String)
    if Client == "" then
      Client = "Q-SYS Smart TV"
      Controls.ClientName.String = Client
    end
    Protocol = Properties.Transport.Value == "TLS (8002)" and "wss" or "ws"
    Port = Protocol == "wss" and 8002 or 8001
    local identity = Protocol .. "|" .. Host .. "|" .. Client
    if StoredIdentity.String ~= identity then
      StoredToken.String = ""
      StoredIdentity.String = identity
    end
    UpdateEnabled()
    if #Host < 1 or #Host > 253 or not Host:match("^[%w][%w.%-]*$") then
      SetStatus(Channels.Remote, 2, "Enter a TV IPv4 address or hostname, without a URL/port")
      return false
    end
    if #Client > 64 or Client:find("%c") then
      SetStatus(Channels.Remote, 2, "Controller name must be 1-64 bytes without control characters")
      return false
    end
    return true
  end

  function Connect()
    Trace("Connect")
    Disconnect()
    Channels.Remote.Blocked = false
    Channels.Art.Blocked = false
    Channels.Remote.RetryDelay = 5
    Channels.Art.RetryDelay = 5
    if Configure() then
      WantConnect = true
      OpenChannel(Channels.Remote)
    end
  end

  --*** Wake-on-LAN: explicit command only, never sent by reconnect ***
  function IsIpv4(address)
    local a, b, c, d = address:match("^(%d+)%.(%d+)%.(%d+)%.(%d+)$")
    if not a then
      return false
    end
    for _, part in ipairs({ a, b, c, d }) do
      if #part > 3 or tonumber(part) > 255 then
        return false
      end
    end
    return true
  end

  function Wake()
    Trace("Wake")
    local mac = Trim(Controls.MACAddress.String):gsub("[:%-]", "")
    local address = Trim(Controls.WakeAddress.String)
    if
      #mac ~= 12
      or not mac:match("^%x+$")
      or mac == "000000000000"
      or mac:upper() == "FFFFFFFFFFFF"
    then
      Notice("Wake: enter the TV's 12-digit MAC address")
      return
    end
    if not IsIpv4(address) then
      Notice("Wake: enter an IPv4 broadcast address")
      return
    end
    local bytes = mac:gsub("..", function(byte)
      return string.char(tonumber(byte, 16))
    end)
    local packet = string.rep(string.char(255), 6) .. string.rep(bytes, 16)
    local ok = pcall(function()
      WakeSocket:Open()
      WakeSocket:Send(address, 9, packet)
    end)
    pcall(function()
      WakeSocket:Close()
    end)
    if ok then
      Controls.LastCommand.String = "Wake-on-LAN"
      Notice("Wake: magic packet sent; TV power is not confirmed")
    else
      Notice("Wake: UDP send failed; check network settings")
    end
  end

  --*** Event handlers ***
  for _, channel in pairs(Channels) do
    channel.Timeout.EventHandler = function()
      channel.Timeout:Stop()
      FailChannel(
        channel,
        "Connection/approval timed out; check TV and press Connect",
        channel.Open == true
      )
    end
    channel.Retry.EventHandler = function()
      channel.Retry:Stop()
      OpenChannel(channel)
    end
    channel.Ping.EventHandler = function()
      if not channel.Socket or not channel.Open then
        channel.Ping:Stop()
        return
      end
      if channel.AwaitingPong then
        FailChannel(channel, "Heartbeat timed out", false)
        return
      end
      channel.AwaitingPong = true
      local ok = pcall(function()
        channel.Socket:Ping()
      end)
      if not ok then
        FailChannel(channel, "Heartbeat failed", false)
      end
    end
  end
  QueueTimer.EventHandler = DrainQueue
  ArtPollTimer.EventHandler = QueryArt
  ArtQueryTimer.EventHandler = QueryArt
  ArtReplyTimer.EventHandler = function()
    ArtReplyTimer:Stop()
    ArtRequestId = nil
    ClearArtState()
    SetStatus(Channels.Art, 1, "Art status timed out; support/state unknown")
    Notice("Art: status reply timed out")
  end
  ArtFreshTimer.EventHandler = function()
    ClearArtState()
    SetStatus(Channels.Art, 1, "Art status expired; awaiting fresh readback")
  end
  for name, key in pairs(RemoteKeys) do
    Controls[name].EventHandler = function()
      SendKey(key)
    end
  end
  Controls.Connect.EventHandler = Connect
  Controls.Disconnect.EventHandler = Disconnect
  Controls.PowerOn.EventHandler = Wake
  Controls.SendKey.EventHandler = function()
    SendKey(Trim(Controls.CustomKey.String))
  end
  Controls.LaunchApp.EventHandler = LaunchApp
  Controls.ArtOn.EventHandler = function()
    SetArt("on")
  end
  Controls.ArtOff.EventHandler = function()
    SetArt("off")
  end
  Controls.ArtRefresh.EventHandler = QueryArt
  Controls.ForgetToken.EventHandler = function()
    Disconnect()
    StoredToken.String = ""
    UpdateEnabled()
    Notice("Pairing token forgotten; press Connect and approve on TV")
  end
  Controls.IPAddress.EventHandler = function()
    Disconnect()
    if Configure() then
      SetStatus(Channels.Remote, 3, "TV address changed; press Connect")
    end
  end
  Controls.ClientName.EventHandler = function()
    Disconnect()
    if Configure() then
      SetStatus(Channels.Remote, 3, "Controller name changed; press Connect")
    end
  end

  --*** Initialization ***
  function Initialize()
    SetupDebug()
    print("Samsung Smart TV " .. PluginInfo.Version)
    Controls.LastCommand.String = ""
    Controls.LastEvent.String = ""
    if Controls.WakeAddress.String == "" then
      Controls.WakeAddress.String = "255.255.255.255"
    end
    Disconnect()
    if Configure() then
      if StoredToken.String ~= "" then
        Connect()
      else
        SetStatus(Channels.Remote, 3, "Press Connect / Pair")
      end
    end
  end
  Initialize()
end
